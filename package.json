{
  "name": "chaos-spin-arena-zero",
  "version": "0.1.0",
  "description": "Chaos Spin: Arena Zero — a physics-driven spinning-top RPG, loot system, Bit-Beast adventure and tournament simulator for the browser.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.js",
    "watch": "node tools/build.js --watch",
    "start": "node tools/build.js && node tools/serve.js",
    "serve": "node tools/serve.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tools/build.js && node tests/browser/run.js",
    "test:determinism": "node tests/browser/determinism.js",
    "balance": "node tools/balance-par.js",
    "balance:check": "node tools/balance-par.js 6 all --check 25-70",
    "test:deep": "node tools/test-deep.js",
    "perf": "node tools/perf.js",
    "perf:check": "node tools/perf.js --check"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "fast-check": "4.10.2",
    "playwright": "1.64.0",
    "three": "0.170.0",
    "tinybench": "6.2.0"
  }
}
